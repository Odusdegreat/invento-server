NODE_ENV=development
PORT=3000
# Comma-separated browser origins. Native mobile requests do not require CORS.
CORS_ORIGINS=http://localhost:8081
SUPABASE_URL=https://your-project.supabase.co
# Backend only. Never put this key in the mobile application.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-secret
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Remote Supabase DATABASE_URL must include ?sslmode=require.
# Set both to deliver password-reset emails through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional app deep link or HTTPS reset page; receives a token query parameter.
PASSWORD_RESET_URL=
EMAIL_VERIFICATION_URL=
# 32 random bytes encoded as 64 hex characters; preserve across deployments.
MFA_ENCRYPTION_KEY=
# Production must use your actual app-associated domain and trusted origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8081
# Without Resend, development uses .tmp/mail. Tests always use the local mailbox.
# Sandbox card linking only. Live secrets are rejected by the integration.
# Payment provider: simulated (default) | paystack (internal only)
PAYMENT_PROVIDER=simulated
# Enable only against an isolated database containing simulated funds.
SANDBOX_ENABLED=false
