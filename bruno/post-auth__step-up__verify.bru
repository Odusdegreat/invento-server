meta {
  name: POST /auth/step-up/verify
  type: http
  seq: 74
}

post {
  url: {{baseUrl}}/auth/step-up/verify
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "pin": "{{pin}}",
    "action": "{{action}}"
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
  if (res.body.stepUpToken) bru.setVar("stepUpToken", res.body.stepUpToken);
}
