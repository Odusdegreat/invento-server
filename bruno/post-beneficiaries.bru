meta {
  name: POST /beneficiaries
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/beneficiaries
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Ama Mensah",
    "bank": "Demo Bank",
    "accountNumber": "001234567890",
    "stepUpToken": "{{stepUpToken}}"
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
  if (res.body.id) bru.setVar("beneficiaryId", res.body.id);
}
