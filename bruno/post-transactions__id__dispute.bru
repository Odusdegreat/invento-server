meta {
  name: POST /transactions/{id}/dispute
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/transactions/{{transactionId}}/dispute
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "reason": "not_recognised"
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
