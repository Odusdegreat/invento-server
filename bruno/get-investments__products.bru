meta {
  name: GET /investments/products
  type: http
  seq: 32
}

get {
  url: {{baseUrl}}/investments/products
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
  if (res.body.length) bru.setVar("productId", res.body[0].id);
}
