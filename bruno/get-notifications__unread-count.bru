meta {
  name: GET /notifications/unread-count
  type: http
  seq: 50
}

get {
  url: {{baseUrl}}/notifications/unread-count
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
