meta {
  name: GET /transfers/{id}/receipt
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/transfers/{{transferId}}/receipt
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
