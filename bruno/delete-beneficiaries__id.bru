meta {
  name: DELETE /beneficiaries/{id}
  type: http
  seq: 22
}

delete {
  url: {{baseUrl}}/beneficiaries/{{beneficiaryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
