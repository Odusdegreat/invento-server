meta {
  name: POST /transfers/quote
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/transfers/quote
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "fromAccountId": "{{accountId}}",
    "amount": 100,
    "currency": "USD"
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
