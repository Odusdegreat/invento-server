meta {
  name: POST /cards
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/cards
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "brand": "visa",
    "label": "Simulated card",
    "last4": "4242",
    "expiry": "12/29"
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
