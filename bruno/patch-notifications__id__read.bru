meta {
  name: PATCH /notifications/{id}/read
  type: http
  seq: 54
}

patch {
  url: {{baseUrl}}/notifications/{{notificationId}}/read
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
