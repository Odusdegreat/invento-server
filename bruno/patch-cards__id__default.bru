meta {
  name: PATCH /cards/{id}/default
  type: http
  seq: 28
}

patch {
  url: {{baseUrl}}/cards/{{cardId}}/default
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
