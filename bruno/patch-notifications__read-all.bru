meta {
  name: PATCH /notifications/read-all
  type: http
  seq: 51
}

patch {
  url: {{baseUrl}}/notifications/read-all
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
