meta {
  name: PUT /investments/watchlist/{id}
  type: http
  seq: 42
}

put {
  url: {{baseUrl}}/investments/watchlist/{{productId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
