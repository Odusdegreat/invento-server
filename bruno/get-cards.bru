meta {
  name: GET /cards
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/cards
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
  if (res.body.length) bru.setVar("cardId", res.body[0].id);
}
