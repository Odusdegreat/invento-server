meta {
  name: PATCH /accounts/{id}/freeze
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/accounts/{{accountId}}/freeze
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
