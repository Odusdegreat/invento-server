meta {
  name: POST /auth/password/reset/confirm
  type: http
  seq: 71
}

post {
  url: {{baseUrl}}/auth/password/reset/confirm
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "replace-with-new-password"
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
