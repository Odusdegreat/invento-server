meta {
  name: DELETE /security/biometric-credentials/{id}
  type: http
  seq: 91
}

delete {
  url: {{baseUrl}}/security/biometric-credentials/{{credentialId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "stepUpToken": "{{stepUpToken}}"
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
