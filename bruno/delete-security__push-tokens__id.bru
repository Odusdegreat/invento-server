meta {
  name: DELETE /security/push-tokens/{id}
  type: http
  seq: 93
}

delete {
  url: {{baseUrl}}/security/push-tokens/{{pushTokenId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
