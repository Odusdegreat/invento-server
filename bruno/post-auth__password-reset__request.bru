meta {
  name: POST /auth/password-reset/request
  type: http
  seq: 70
}

post {
  url: {{baseUrl}}/auth/password-reset/request
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
