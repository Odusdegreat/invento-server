meta {
  name: POST /cards/freeze-all
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/cards/freeze-all
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "frozen": true
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
