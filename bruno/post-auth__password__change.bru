meta {
  name: POST /auth/password/change
  type: http
  seq: 78
}

post {
  url: {{baseUrl}}/auth/password/change
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "current": "{{password}}",
    "next": "replace-with-new-password",
    "stepUpToken": "{{stepUpToken}}"
  }
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
