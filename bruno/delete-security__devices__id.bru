meta {
  name: DELETE /security/devices/{id}
  type: http
  seq: 58
}

delete {
  url: {{baseUrl}}/security/devices/{{deviceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  if (res.body.challengeToken) bru.setVar("challengeToken",res.body.challengeToken);
  if (res.body.setupToken) bru.setVar("setupToken",res.body.setupToken);
}
